<%- include('partials/head') %>
<section>
  <div class="container contendor">
    <div class="row">
      <div class="col-lg-4 text-center"><img class="logosintituciones" src="/img/logo.png" width="170" alt="PNK"></div>
      <div class="col-lg-4 text-center">
        <%- include('partials/foto', { foto: restaurante.foto, clase: 'logosintituciones', ancho: 170, alto: null }) %>
      </div>
      <div class="col-lg-4">
        <div class="carro"><div class="media float-right">
          <a class="volver" href="/carta/<%= restaurante.id %>">Volver a la Carta</a>&nbsp;&nbsp;
          <a class="limpiar" href="#">Eliminar Todo</a>
        </div></div>
      </div>
    </div>
  </div>
</section>
<section><div class="container contendor"><h4 class="intro-title text-center">Productos Agregados para Solicitar</h4></div></section>
<section>
  <div class="container contendor"><div class="row"><div class="col-lg-12">
    <table class="table table-hover table-lg">
      <thead><tr><th scope="col">Código</th><th scope="col">Producto</th><th scope="col">Precio</th><th scope="col">Acción</th></tr></thead>
      <tbody>
        <% filas.forEach(function (f) { %>
          <tr>
            <th scope="row"><%= f.id %></th>
            <td><%= f.nombre %></td>
            <td><%= monedaChilena(f.precio) %></td>
            <td><a class="elim" href="#" data-uid="<%= f.uid %>" aria-label="Quitar <%= f.nombre %>"><%- include('partials/icono', { nombre: 'basura', tam: '2em' }) %></a></td>
          </tr>
        <% }) %>
        <% if (!filas.length) { %><tr><td colspan="4" class="text-center">Aún no has seleccionado productos.</td></tr><% } %>
      </tbody>
    </table>
    <hr><br>
    <h3 class="price-tag">Total : <%= monedaChilena(total) %></h3>
    <h3 class="price-tag text-center">¡Si estás listo con tu pedido, llama al garzón para solicitarlo!</h3>
  </div></div></div>
</section>
<%- include('partials/footer') %>

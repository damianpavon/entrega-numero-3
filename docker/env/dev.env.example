# ---- DESARROLLO ---- (copiar a dev.env; dev.env no se sube a Git)
NODE_ENV=development
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=carta_dev
DB_USER=carta_dev
DB_PASSWORD=dev_password_local
DB_SSL=false
SESSION_SECRET=desarrollo-local-secreto-de-mas-de-32-caracteres

RUN_MIGRATIONS=true
# Carga restaurantes de ejemplo y un usuario demo SOLO en desarrollo
SEED_DEMO=true
DEMO_USER_EMAIL=demo@carta.cl
DEMO_USER_NAME=Usuario Demo
DEMO_USER_PASSWORD=Demo#Dev2026

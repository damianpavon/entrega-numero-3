# ---- PRODUCCIÓN ---- (copiar a prod.env y CAMBIAR los secretos; prod.env no se sube a Git)
# En AWS estas variables las inyecta la instancia (ver infra/aws).
NODE_ENV=production
PORT=3000
DB_HOST=db                 # en AWS: endpoint de RDS
DB_PORT=5432
DB_NAME=carta_prod
DB_USER=carta_prod
DB_PASSWORD=CAMBIAR_clave_larga_prod
DB_SSL=false               # en AWS (RDS): true
SESSION_SECRET=CAMBIAR_por_un_valor_aleatorio_de_64_caracteres_hexadecimales
COOKIE_SECURE=true         # requiere HTTPS. Si pruebas por http local, pon false
TRUST_PROXY=1              # solo Nginx. En AWS el stack usa 3 (Cloudflare + ALB + Nginx)
RUN_MIGRATIONS=true
SEED_DEMO=false            # producción NUNCA carga datos ni usuarios de demo

# ---- QA ---- (copiar a qa.env y CAMBIAR los secretos; qa.env no se sube a Git)
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=carta_qa
DB_USER=carta_qa
DB_PASSWORD=CAMBIAR_clave_larga_qa
DB_SSL=false
SESSION_SECRET=CAMBIAR_por_un_valor_aleatorio_de_64_caracteres_hexadecimales
COOKIE_SECURE=false        # QA se prueba por http://localhost:8081; con HTTPS ponlo en true
TRUST_PROXY=1
RUN_MIGRATIONS=true
SEED_DEMO=true             # datos de ejemplo para probar; sin usuario demo (se crea con crear-usuario)
